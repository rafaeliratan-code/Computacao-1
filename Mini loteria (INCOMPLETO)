/******************************************************************************

Escreva um programa que sorteia 3 números diferentes entre 1 e 20.

O usuário deve adivinhar estes 3 números. Quando o usuário conseguir acertar os 3 números, o programa deverá classificar o usuário como:

ÓTIMO: se ele conseguiu em 1 a 30 tentativas;
BOM: 31 a 60 tentativas;
FRACO: 61 a 100 tentativas;
PÉSSIMO: Mais que 100 tentativas.
Uma tentativa é um conjunto de 3 números. Cada tentativa custa 1 real.

Escreva a classificação do usuário na tela e quantos reais ele gastou.

Caso o usuário não tenha sido classificado como ÓTIMO ou BOM, pergunte ao usuário se ele quer tentar de novo em uma nova rodada.
Se ele quiser, o programa recomeça. No final de tudo, o programa deve mostrar todo o dinheiro gasto pelo usuário em todas as rodadas.

*******************************************************************************/
#include<stdio.h>
#include<locale.h>
#include <stdlib.h>
#include <time.h>

int main()
{

	setlocale(LC_ALL, "Portuguese");
	srand(time(0));

	int n1, n2, n3, nsecreto;
	int chute;
	int tentativas;
	int chute1, chute2, chute3;

	n1 = (rand()%20)+1;
	n2 = (rand()%20)+1;
	n3 = (rand()%20)+1;
	nsecreto = n1, n2, n3;
	tentativas = 1;
	int qtd_tentativas;
	int continua = 1;

	while(continua)
	{
		do {
			printf("Os números sorteados são: %d %d %d \n", n1, n2, n3);
			printf("Digite os números sorteados: \n");
			scanf("%d %d %d", &chute1, &chute2, &chute3);

			chute = chute1, chute2, chute3;

			if (chute!=nsecreto)
				qtd_tentativas = qtd_tentativas + 1;

		}
		while(chute!=nsecreto);

		printf("Quantidade de tentativas: %d\n", qtd_tentativas);


		if(qtd_tentativas <= 3)
		{
			printf("Você é ÓTIMO!\n");
			continua = 0;
		}
		else if(qtd_tentativas <= 6)
		{
			printf("Você é BOM!\n");
			continua = 0;

		}
		else if(qtd_tentativas <=10)
		{
			printf("Você é FRACO!\n");

		}
		else
		{
			printf("Você é PÉSSIMO!\n");

		}

		return 0;

	}
}


